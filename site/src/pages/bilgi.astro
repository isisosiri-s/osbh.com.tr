---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

// NOT (Claude Code): Eski sitede /bilgi/ sayfası bir tema demosundan kalma SAHTE
// içerik barındırıyordu (İngilizce, Londra adresi, uydurma telefon/e-posta).
// URL zaten arama motorlarında indeksli olduğu için silmek yerine gerçek ve
// faydalı bir SSS içeriğiyle yeniden dolduruldu.

const faq = [
  { q: 'USBS (Uzaktan Sağlık Bilgi Sistemi) nedir?', a: 'USBS, Sağlık Bakanlığı yönetmeliğine uygun olarak doktorların ve sağlık kuruluşlarının kendi web siteleri üzerinden online muayene, e-reçete, e-rapor ve e-Nabız entegrasyonu ile hizmet vermesini sağlayan bir yazılım altyapısıdır.' },
  { q: 'Paketleri nasıl satın alabilirim?', a: 'Paketlerimiz şu anda online satışa kapalıdır. İlgilendiğiniz paketin sayfasındaki "Teklif Al / Bize Ulaşın" butonuna tıklayarak veya İletişim sayfamızdan bize ulaşarak fiyat teklifi ve aktivasyon süreci hakkında bilgi alabilirsiniz.' },
  { q: 'Ödeme seçenekleri nelerdir?', a: 'Paketlerimizde taksitli ödeme ve kredi kartı ile ödeme seçenekleri sunulmaktadır. Detaylar için bizimle iletişime geçebilirsiniz.' },
  { q: 'Aktivasyon süreci ne kadar sürer?', a: 'Aktivasyon süreci seçtiğiniz pakete ve doktor sayınıza göre değişmektedir. Süreç boyunca web sitenizi ve online muayene altyapınızı sizin için hazırlıyor, mevcut web sitenizle entegre ediyoruz.' },
  { q: 'Verileriniz güvende mi?', a: 'Evet. Tüm sistemlerimiz ISO 27001 Bilgi Güvenliği Yönetim Sistemi standardına uygun olarak yönetilir, SSL sertifikası ile korunur ve Türkiye lokasyonlu veri merkezlerinde günlük olarak yedeklenir.' },
  { q: 'Firmanız Sağlık Bakanlığı nezdinde kayıtlı mı?', a: 'Evet, firmamız Sağlık Bakanlığı Aktif USBS Listesi\'nde kayıtlıdır. Listeye footer bölümündeki "Aktif USBS Listesi" bağlantısından ulaşabilirsiniz.' },
];
---

<BaseLayout
  title="Bilgi - Sıkça Sorulan Sorular - Online Sağlık Bilişim Hizmetleri A.Ş."
  description="OSBH paketleri, ödeme, aktivasyon süreci ve veri güvenliği hakkında sıkça sorulan sorular."
  canonical="https://osbh.com.tr/bilgi/"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-14">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-10 text-center">Sıkça Sorulan Sorular</h1>

    <div class="divide-y divide-slate-200 border-t border-b border-slate-200">
      {faq.map((item, i) => (
        <details class="group py-4" open={i === 0}>
          <summary class="flex items-center justify-between cursor-pointer font-semibold text-slate-900 list-none">
            {item.q}
            <svg class="h-5 w-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="text-sm text-slate-500 mt-3 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>

    <p class="text-center text-slate-600 mt-10">
      Başka bir sorunuz mu var? <a href={SITE.phoneHref} class="font-bold text-teal-700">{SITE.phone}</a>
      veya <a href="/iletisim/" class="font-bold text-teal-700">iletişim formumuz</a> üzerinden bize ulaşın.
    </p>
  </div>
</BaseLayout>
