---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../lib/site';

const merkez = SITE.offices[0];
const mapSrc = `https://www.google.com/maps?q=${merkez.lat},${merkez.lng}&z=16&output=embed`;
---

<BaseLayout
  title="İletişim - Online Sağlık Bilişim Hizmetleri A.Ş."
  description={merkez.address}
  canonical="https://osbh.com.tr/iletisim/"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-14">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Bize Ulaşın</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-14">
      <div class="rounded-2xl overflow-hidden border border-slate-200 h-80 lg:h-auto">
        <iframe
          src={mapSrc}
          class="w-full h-full min-h-[320px]"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Merkez Ofis Konumu"
        ></iframe>
      </div>
      <ContactForm />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-14">
      {SITE.offices.map((o) => (
        <div class="rounded-2xl bg-slate-50 p-6">
          <h2 class="font-bold text-slate-900 mb-1">{o.name}</h2>
          <p class="text-sm text-slate-600">{o.address}</p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-center">
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Telefon</p>
        <a href={SITE.phoneHref} class="text-lg font-bold text-teal-700">{SITE.phone}</a>
      </div>
      <div class="rounded-2xl border border-slate-200 p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">E-posta</p>
        <a href={`mailto:${SITE.email}`} class="text-lg font-bold text-teal-700">{SITE.email}</a>
      </div>
    </div>
  </div>
</BaseLayout>
