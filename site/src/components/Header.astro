---
import { NAV_LINKS, SITE } from '../lib/site';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-100 shadow-sm">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/images/logosd-8b84d523ea.webp" alt={SITE.name} class="h-10 w-auto" width="160" height="40" />
      </a>

      <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
        {NAV_LINKS.map((link) => (
          link.children ? (
            <div class="relative group">
              <button
                type="button"
                class={`inline-flex items-center gap-1 px-3 py-2 rounded-md transition-colors ${
                  link.children.some((c) => c.href === currentPath)
                    ? 'text-teal-700 bg-teal-50'
                    : 'text-slate-600 hover:text-teal-700 hover:bg-slate-50'
                }`}
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block">
                <div class="min-w-64 rounded-lg border border-slate-100 bg-white py-2 shadow-lg">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class={`block px-4 py-2 text-sm transition-colors ${
                        currentPath === child.href
                          ? 'text-teal-700 bg-teal-50'
                          : 'text-slate-600 hover:text-teal-700 hover:bg-slate-50'
                      }`}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-md transition-colors ${
                currentPath === link.href
                  ? 'text-teal-700 bg-teal-50'
                  : 'text-slate-600 hover:text-teal-700 hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          )
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <a href={SITE.phoneHref} class="text-sm font-semibold text-slate-700 hover:text-teal-700">
          {SITE.phone}
        </a>
        <a
          href="/iletisim/"
          class="inline-flex items-center rounded-full bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-teal-700 transition-colors"
        >
          Teklif Al
        </a>
      </div>

      <button
        id="mobile-menu-btn"
        class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-slate-600 hover:bg-slate-100"
        aria-label="Menüyü aç/kapat"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="lg:hidden hidden border-t border-slate-100 bg-white">
    <div class="px-4 py-3 space-y-1">
      {NAV_LINKS.map((link) => (
        link.children ? (
          <details class="group" open={link.children.some((c) => c.href === currentPath)}>
            <summary class={`flex items-center justify-between px-3 py-2 rounded-md text-sm font-medium cursor-pointer list-none ${
              link.children.some((c) => c.href === currentPath)
                ? 'text-teal-700 bg-teal-50'
                : 'text-slate-600 hover:bg-slate-50'
            }`}>
              <span>{link.label}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="ml-3 mt-1 space-y-1 border-l border-slate-100 pl-3">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class={`block px-3 py-2 rounded-md text-sm font-medium ${
                    currentPath === child.href ? 'text-teal-700 bg-teal-50' : 'text-slate-600 hover:bg-slate-50'
                  }`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={link.href}
            class={`block px-3 py-2 rounded-md text-sm font-medium ${
              currentPath === link.href ? 'text-teal-700 bg-teal-50' : 'text-slate-600 hover:bg-slate-50'
            }`}
          >
            {link.label}
          </a>
        )
      ))}
      <a href="/iletisim/" class="block mt-2 rounded-full bg-teal-600 px-4 py-2.5 text-center text-sm font-semibold text-white">
        Teklif Al
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!!isHidden));
  });
</script>
