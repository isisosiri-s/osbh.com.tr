---
import { TESTIMONIALS } from '../lib/site';
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
  {TESTIMONIALS.map((t) => (
    <figure class="rounded-2xl bg-slate-50 border border-slate-100 p-6 flex flex-col">
      <blockquote class="text-sm text-slate-600 leading-relaxed flex-1">"{t.text}"</blockquote>
      <figcaption class="mt-4 flex items-center gap-3">
        <img src={t.image} alt="" class="h-10 w-10 rounded-full object-cover" loading="lazy" />
        <div class="text-sm">
          <span class="block font-semibold text-slate-900">{t.author}</span>
          {t.location && <span class="text-slate-500">{t.location}</span>}
        </div>
      </figcaption>
    </figure>
  ))}
</div>
