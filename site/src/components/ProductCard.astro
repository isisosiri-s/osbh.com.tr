---
interface Props {
  slug: string;
  title: string;
  image?: string;
  price: string;
  originalPrice?: string;
  discountPercent?: string;
  activation?: string;
  categoryLabel: string;
}
const { slug, title, image, price, originalPrice, discountPercent, activation, categoryLabel } = Astro.props;

function monthly(priceStr: string) {
  const n = parseFloat(priceStr.replace(/\./g, '').replace(',', '.'));
  if (Number.isNaN(n)) return null;
  return Math.round(n / 12).toLocaleString('tr-TR');
}
const monthlyPrice = monthly(price);
---

<div class="group relative flex flex-col rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
  {discountPercent && (
    <span class="absolute top-3 left-3 z-10 rounded-full bg-rose-600 px-2.5 py-1 text-xs font-bold text-white">
      -%{discountPercent}
    </span>
  )}
  <a href={`/urun/${slug}/`} class="block aspect-[4/3] overflow-hidden bg-slate-100">
    {image && (
      <img
        src={image}
        alt={title}
        loading="lazy"
        width="500"
        height="375"
        class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    )}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <span class="text-xs font-semibold uppercase tracking-wide text-teal-600 mb-1">{categoryLabel}</span>
    <h3 class="text-lg font-bold text-slate-900 mb-1">
      <a href={`/urun/${slug}/`} class="hover:text-teal-700">{title}</a>
    </h3>
    {activation && <p class="text-sm text-slate-500 mb-3">{activation}</p>}

    <div class="mt-auto pt-3">
      <div class="flex items-baseline gap-2">
        {originalPrice && (
          <span class="text-sm text-slate-400 line-through">{originalPrice} ₺</span>
        )}
        <span class="text-2xl font-extrabold text-slate-900">{price} ₺</span>
        <span class="text-xs text-slate-500">/yıl</span>
      </div>
      {monthlyPrice && <p class="text-xs text-slate-500 mt-0.5">aylık ≈ {monthlyPrice} ₺</p>}

      <a
        href={`/urun/${slug}/`}
        class="mt-4 block w-full rounded-full bg-teal-600 hover:bg-teal-700 px-4 py-2.5 text-center text-sm font-semibold text-white transition-colors"
      >
        İncele &amp; Teklif Al
      </a>
    </div>
  </div>
</div>
