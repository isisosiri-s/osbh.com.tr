---
interface ProductEntry {
  data: {
    title: string;
    slug: string;
    price: string;
    sections: { title: string; items: { name: string; value: string | boolean }[] }[];
  };
}
interface Props {
  products: ProductEntry[];
}
const { products } = Astro.props;

const sectionTitles = products[0]?.data.sections.map((s) => s.title) ?? [];

// Bazı özellik isimleri paketler arasında miktar bilgisiyle birlikte değişir
// (örn. "5 Ad/Ay Video Yayınlama" / "15 Ad/Ay Video Yayınlama" / "Sınırsız Video Yayınlama").
// Satırları doğru eşleştirmek için isim, miktar öneki atılarak normalize edilir.
const QUANTITY_PREFIX = /^(\d+\s*Ad\/Ay|Sınırsız)\s+/i;

function normalizeName(name: string) {
  return name.replace(QUANTITY_PREFIX, '');
}

function getQuantityLabel(name: string) {
  const match = name.match(QUANTITY_PREFIX);
  return match ? match[1] : null;
}

function findItem(p: ProductEntry, sectionTitle: string, itemName: string) {
  const section = p.data.sections.find((s) => s.title === sectionTitle);
  return section?.items.find((i) => normalizeName(i.name) === normalizeName(itemName)) ?? null;
}
---

<div class="overflow-x-auto rounded-2xl border border-slate-200">
  <table class="w-full text-sm border-collapse min-w-[640px]">
    <thead>
      <tr class="bg-slate-50">
        <th class="text-left p-4 font-semibold text-slate-700 w-1/3">Özellik</th>
        {products.map((p) => (
          <th class="text-center p-4 font-bold text-slate-900">
            <a href={`/urun/${p.slug}/`} class="hover:text-teal-700">{p.data.title}</a>
            <div class="text-xs font-normal text-slate-500 mt-1">{p.data.price} ₺/yıl</div>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {sectionTitles.map((sectionTitle) => {
        const firstSection = products[0].data.sections.find((s) => s.title === sectionTitle)!;
        return (
          <>
            <tr class="bg-teal-50/60">
              <td colspan={products.length + 1} class="p-3 font-bold text-teal-700 text-xs uppercase tracking-wide">
                {sectionTitle}
              </td>
            </tr>
            {firstSection.items.map((item) => {
              const isQuantityRow = getQuantityLabel(item.name) !== null;
              return (
                <tr class="border-t border-slate-100">
                  <td class="p-3 text-slate-600">{normalizeName(item.name)}</td>
                  {products.map((p) => {
                    const matched = findItem(p, sectionTitle, item.name);
                    const val = matched?.value ?? null;
                    if (isQuantityRow) {
                      const quantity = matched ? getQuantityLabel(matched.name) : null;
                      return (
                        <td class="p-3 text-center">
                          <span class="font-medium text-slate-800">{quantity ?? '-'}</span>
                        </td>
                      );
                    }
                    return (
                      <td class="p-3 text-center">
                        {val === 'Var' || val === true ? (
                          <svg class="h-5 w-5 text-teal-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                        ) : val === 'Yok' ? (
                          <svg class="h-5 w-5 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        ) : (
                          <span class="font-medium text-slate-800">{val}</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </>
        );
      })}
    </tbody>
  </table>
</div>
