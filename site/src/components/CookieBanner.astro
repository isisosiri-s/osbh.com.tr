---
---
<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden bg-slate-900/95 backdrop-blur text-slate-100 px-4 py-4 sm:py-3"
  role="dialog"
  aria-live="polite"
  aria-label="Çerez onayı"
>
  <div class="mx-auto max-w-7xl flex flex-col sm:flex-row items-center gap-3 sm:gap-6">
    <p class="text-sm text-slate-300 flex-1">
      Web sitemizdeki deneyiminizi iyileştirmek için tanımlama bilgileri (çerezler) kullanıyoruz.
      Bu web sitesine göz atarak, <a href="/cerez-politikasi/" class="underline hover:text-teal-400">çerez kullanımımızı</a> kabul etmiş olursunuz.
    </p>
    <button
      id="cookie-accept"
      class="shrink-0 rounded-full bg-teal-600 hover:bg-teal-700 px-5 py-2 text-sm font-semibold text-white transition-colors"
    >
      Kabul Et
    </button>
  </div>
</div>

<script>
  const KEY = 'osbh-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  const btn = document.getElementById('cookie-accept');
  try {
    if (!localStorage.getItem(KEY)) {
      banner?.classList.remove('hidden');
    }
  } catch {}
  btn?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch {}
    banner?.classList.add('hidden');
  });
</script>
